rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if the user is an admin
    // Note: The role is stored in the 'users' collection
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. Users Collection & Subcollections
    match /users/{userId} {
      // Users can read and write their own profile data. Admins can read/write all.
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Emergency Contacts Subcollection
      match /emergencyContacts/{contactId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      // Chats Subcollection
      match /chats/{chatId} {
        allow read, write: if isOwner(userId) || isAdmin();
        
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }
    }

    // 2. Emergency Alerts Collection
    match /emergency_alerts/{alertId} {
      // Any authenticated user can create an alert
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can view their own alerts. Admins can view all alerts.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Only admins can update the status of an alert or delete it
      allow update, delete: if isAdmin();
    }

    // 3. Police Notifications Collection
    match /police_notifications/{notificationId} {
      // Any authenticated user can trigger a notification
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Only admins can read, update, or delete notifications
      allow read, update, delete: if isAdmin();
    }

    // 4. Reports Collection
    match /reports/{reportId} {
      // Any authenticated user can create a report
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Users can view, update, or delete their own reports. Admins can view/update all.
      allow read, update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    // Secure by default: Any collection not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
