<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ai Women Safety</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ai_women_safety</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	
	<!-- ============================================ -->
	<!-- Permissions for Women Safety App Features -->
	<!-- ============================================ -->
	
	<!-- Location Permissions - Required for emergency location sharing -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Secura needs your location to share it with emergency contacts during emergencies and to help you find nearby safe places.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Secura needs your location to share it with emergency contacts during emergencies, even when the app is in the background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Secura needs your location to share it with emergency contacts during emergencies, even when the app is in the background.</string>
	
	<!-- Phone Call Permission - Required for emergency calls -->
	<key>NSPhoneCallUsageDescription</key>
	<string>Secura needs to make emergency calls to your emergency contacts and emergency services.</string>
	
	<!-- Photo Library Permission - Required for incident reports with images -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Secura needs access to your photo library to attach images to incident reports for documentation purposes.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Secura needs access to save images to your photo library when documenting incidents.</string>
	
	<!-- Camera Permission - Required for taking photos in incident reports -->
	<key>NSCameraUsageDescription</key>
	<string>Secura needs access to your camera to take photos for incident reports. Your safety is our priority - only use this feature when it's safe to do so.</string>
	
	<!-- Microphone Permission - Optional, for future voice features -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Secura may need access to your microphone for voice-activated emergency features and hands-free operation.</string>
	
	<!-- Background Modes - For location tracking during emergencies -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	
	<!-- App Transport Security - Allow HTTP connections if needed (not recommended for production) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
